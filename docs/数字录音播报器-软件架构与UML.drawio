;font-size:12.2px;color:#7A2E2E&quot;&gt;格式不符 → ValueError&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.5px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;22050 Hz / 单声道 / 16 位&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FBE9E9;strokeColor=#C88A8A;strokeWidth=1.5;fontColor=#7A2E2E;fontSize=10.5;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1000" y="890" width="195" height="80" as="geometry"/></mxCell><mxCell id="p6-v28" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:12.2px;color:#7A4F1D&quot;&gt;readframes(2048) → stream.write(data)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;分块读取直到文件结束&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FDF3E5;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10.2;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="555" y="1005" width="390" height="58" as="geometry"/></mxCell><mxCell id="p6-v29" value="&lt;b&gt;播放完毕 → 返回 cli&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;关闭输出流&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#1F3864;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="1105" width="340" height="56" as="geometry"/></mxCell><mxCell id="p6-e30" value="③ 打开输出流" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=10.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v16" target="p6-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v25" target="p6-v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-e32" value="匹配" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3F8F65;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=10;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v26" target="p6-v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-e33" value="不符" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C05B5B;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=10;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v26" target="p6-v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A9CC6;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=9.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v28" target="p6-v25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="1034"/><mxPoint x="540" y="844"/></Array></mxGeometry></mxCell><mxCell id="p6-e35" value="遍历结束" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=10;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v28" target="p6-v29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-v36" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7A4F1D&quot;&gt;WAV 格式契约&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;22050 Hz 采样率&lt;br&gt;单声道（1 channel）&lt;br&gt;16 位 PCM（2 字节 / 采样）&lt;br&gt;&lt;br&gt;校验三元组 = (nchannels, sampwidth, framerate)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FDF3E5;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=11.2;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1210" y="150" width="400" height="210" as="geometry"/></mxCell><mxCell id="p6-v37" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7A4F1D&quot;&gt;TOKEN_FILES · 文件名映射&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.8px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;span style='font-family:Menlo;font-size:10.3px;line-height:1.7'&gt;零 ling　一 yi　二 er　三 san&lt;br&gt;四 si　五 wu　六 liu　七 qi　八 ba&lt;br&gt;九 jiu　十 shi　百 bai　千 qian&lt;br&gt;万 wan　亿 yi_large　兆 zhao&lt;br&gt;京 jing　负 fu　点 dian&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#7A4F1D'&gt;亿使用 yi_large，避免与“一”重名&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFDF8;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10.8;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1210" y="390" width="400" height="250" as="geometry"/></mxCell><mxCell id="p6-v38" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7A2E2E&quot;&gt;错误契约&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;span style='font-family:Menlo;font-size:10.8px'&gt;ValueError&lt;/span&gt;：缺失录音 / 格式不符&lt;br&gt;&lt;span style='font-family:Menlo;font-size:10.8px'&gt;RuntimeError&lt;/span&gt;：sounddevice 加载失败&lt;br&gt;cli 捕获后打印中文提示&lt;br&gt;自检：check_files.py / 菜单 ③&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FBE9E9;strokeColor=#C88A8A;strokeWidth=1.5;fontColor=#7A2E2E;fontSize=11;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1210" y="670" width="400" height="150" as="geometry"/></mxCell><mxCell id="p6-v39" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15px;color:#4B5563&quot;&gt;输入与输出&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;输入：recordings/*.wav（19 个）&lt;br&gt;输出：sounddevice → 扬声器 / 耳机&lt;br&gt;每个 token 对应一个单字 WAV&lt;br&gt;同一字重复出现时重复播放同一文件&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F5F6F8;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#4B5563;fontSize=11;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1210" y="850" width="400" height="150" as="geometry"/></mxCell><mxCell id="p6-v40" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;&lt;span style='color:#5B7FA6'&gt;━━&lt;/span&gt; 主流程&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#C05B5B'&gt;┅┅&lt;/span&gt; 异常出口&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;失败快速返回：不会出现播放到一半才发现缺文件&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="70" y="1170" width="1550" height="24" as="geometry"/></mxCell><mxCell id="p6-l41" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1198" as="sourcePoint"/><mxPoint x="1620" y="1198" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p6-v42" value="&lt;span style='font-size:11.5px;color:#6B7280'&gt;数字录音播报器 · number_voice 1.0 · 软件架构与 UML&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="1206" width="700" height="26" as="geometry"/></mxCell><mxCell id="p6-v43" value="&lt;div style='text-align:right;font-size:11.5px;color:#6B7280'&gt;06 / 13&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="1420" y="1206" width="200" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p7" name="07 模块详解 cli"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1120" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7-v1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#1F3864;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="38" as="geometry"/></mxCell><mxCell id="p7-v2" value="图 7　模块详解 ③：cli.py 交互编排" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=25;fontColor=#1F3864;fontFamily=Songti SC;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="30" width="1080" height="40" as="geometry"/></mxCell><mxCell id="p7-v3" value="main() 是唯一的流程编排者：读取菜单 → 调用 numbers / audio → 打印结果或错误" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=12.8;fontColor=#5B6B7C;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="84" y="74" width="1150" height="26" as="geometry"/></mxCell><mxCell id="p7-v4" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;《软件开发方法》课程任务四 · Python 3.12&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=17;fillColor=#F3F6FA;strokeColor=#D5DEE8;strokeWidth=1.5;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="38" width="340" height="34" as="geometry"/></mxCell><mxCell id="p7-l5" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="112" as="sourcePoint"/><mxPoint x="1620" y="112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-v6" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;main() · 菜单循环&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.8px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• &lt;span style='font-family:Menlo;font-size:10.8px'&gt;store = AudioStore()&lt;/span&gt;&lt;br&gt;• &lt;span style='font-family:Menlo;font-size:10.8px'&gt;while True&lt;/span&gt;：显示 5 项菜单 → 读取 1–5 → 分发&lt;br&gt;• ① 查看读法　② 播放数字　③ 文件状态　④ 试听单字　⑤ 退出&lt;br&gt;• 无 GUI；播放阻塞；输入错误只提示，不退出程序&lt;br&gt;• 菜单 ③ 不播放声音，只读文件状态&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=11.8;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="540" y="150" width="620" height="250" as="geometry"/></mxCell><mxCell id="p7-v7" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14.2px;color:#1F3864&quot;&gt;① 查看读法 · 菜单 1&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.8px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;span style='font-family:Menlo;font-size:10.8px'&gt;show_reading(read_text(), choose_mode())&lt;/span&gt;&lt;br&gt;• 选择数值 / 逐位读法&lt;br&gt;• 打印读法与字音顺序&lt;br&gt;&lt;span style='color:#7A2E2E'&gt;catch ValueError → 输入错误&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9.6px;color:#7A8EA8'&gt;示例：2382 → 二千三百八十二&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=10.8;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="300" height="200" as="geometry"/></mxCell><mxCell id="p7-v8" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14.2px;color:#1F3864&quot;&gt;② 播放数字 · 菜单 2&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.8px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;span style='font-family:Menlo;font-size:10.8px'&gt;play_number(store)&lt;/span&gt;&lt;br&gt;• read_text → choose_mode → show_reading&lt;br&gt;• store.play(tokens)&lt;br&gt;&lt;span style='color:#7A2E2E'&gt;catch ValueError / RuntimeError&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9.6px;color:#7A8EA8'&gt;示例：12.50 → 十二点五零&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=10.8;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="380" y="470" width="320" height="200" as="geometry"/></mxCell><mxCell id="p7-v9" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14.2px;color:#1F3864&quot;&gt;③ 查看文件状态 · 菜单 3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.8px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;span style='font-family:Menlo;font-size:10.8px'&gt;print_file_list(store)&lt;/span&gt;&lt;br&gt;• 遍历 TOKEN_FILES（19 项）&lt;br&gt;• store.path / store.missing&lt;br&gt;• 不播放声音&lt;br&gt;&lt;span style='font-size:9.6px;color:#7A8EA8'&gt;输出：19 项状态 + 缺失清单&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=10.8;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="720" y="470" width="280" height="200" as="geometry"/></mxCell><mxCell id="p7-v10" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14.2px;color:#1F3864&quot;&gt;④ 试听单字 · 菜单 4&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.8px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;span style='font-family:Menlo;font-size:10.8px'&gt;preview_token(store)&lt;/span&gt;&lt;br&gt;• choose_token → print_file_list&lt;br&gt;• store.play(token)&lt;br&gt;&lt;span style='color:#7A2E2E'&gt;catch ValueError / IndexError&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9.6px;color:#7A8EA8'&gt;示例：序号 01 → 零&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=10.8;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1020" y="470" width="300" height="200" as="geometry"/></mxCell><mxCell id="p7-v11" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14.2px;color:#1F3864&quot;&gt;⑤ 退出 · 菜单 5&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.8px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 打印“再见。”&lt;br&gt;• break 退出 while&lt;br&gt;&lt;span style='font-size:10.8px;color:#5B6B7C'&gt;不抛异常&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9.6px;color:#7A8EA8'&gt;返回 shell&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=10.8;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1340" y="470" width="250" height="200" as="geometry"/></mxCell><mxCell id="p7-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p7-v6" target="p7-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p7-v6" target="p7-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p7-v6" target="p7-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p7-v6" target="p7-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p7-v6" target="p7-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-v17" value="&lt;b style='font-size:14px;color:#4C3B72'&gt;辅助函数（各菜单复用）&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="500" height="24" as="geometry"/></mxCell><mxCell id="p7-v18" value="&lt;span style='font-family:Menlo;font-size:10.8px'&gt;read_text(prompt)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.3px'&gt;去空白&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F0FA;strokeColor=#A99AC9;strokeWidth=1.5;fontColor=#4C3B72;fontSize=11;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="250" height="52" as="geometry"/></mxCell><mxCell id="p7-v19" value="&lt;span style='font-family:Menlo;font-size:10.8px'&gt;choose_mode()&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.3px'&gt;读法选择&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F0FA;strokeColor=#A99AC9;strokeWidth=1.5;fontColor=#4C3B72;fontSize=11;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="740" width="250" height="52" as="geometry"/></mxCell><mxCell id="p7-v20" value="&lt;span style='font-family:Menlo;font-size:10.8px'&gt;show_reading(text, mode)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.3px'&gt;打印&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F0FA;strokeColor=#A99AC9;strokeWidth=1.5;fontColor=#4C3B72;fontSize=11;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="740" width="270" height="52" as="geometry"/></mxCell><mxCell id="p7-v21" value="&lt;span style='font-family:Menlo;font-size:10.8px'&gt;print_file_list(store)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.3px'&gt;19 项&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F0FA;strokeColor=#A99AC9;strokeWidth=1.5;fontColor=#4C3B72;fontSize=11;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="740" width="270" height="52" as="geometry"/></mxCell><mxCell id="p7-v22" value="&lt;span style='font-family:Menlo;font-size:10.8px'&gt;choose_token(store)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.3px'&gt;序号→字音&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F0FA;strokeColor=#A99AC9;strokeWidth=1.5;fontColor=#4C3B72;fontSize=11;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="740" width="280" height="52" as="geometry"/></mxCell><mxCell id="p7-v23" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#7A2E2E&quot;&gt;统一异常边界&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.9px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;菜单 ① 捕获 &lt;span style='font-family:Menlo;font-size:10.8px'&gt;ValueError&lt;/span&gt;；菜单 ② 捕获 &lt;span style='font-family:Menlo;font-size:10.8px'&gt;ValueError / RuntimeError&lt;/span&gt;；菜单 ④ 内部捕获 &lt;span style='font-family:Menlo;font-size:10.8px'&gt;ValueError / IndexError&lt;/span&gt;；&lt;span style='font-family:Menlo;font-size:10.8px'&gt;__main__&lt;/span&gt; 捕获 &lt;span style='font-family:Menlo;font-size:10.8px'&gt;KeyboardInterrupt&lt;/span&gt;&lt;br&gt;所有异常在 cli 边界转成用户能看懂的中文提示；程序保持运行，菜单 ⑤ 才退出&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FBE9E9;strokeColor=#C88A8A;strokeWidth=1.5;fontColor=#7A2E2E;fontSize=10.9;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="60" y="825" width="1530" height="100" as="geometry"/></mxCell><mxCell id="p7-v24" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:13.5px;color:#1F3864&quot;&gt;依赖方向&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;cli 是唯一编排层：numbers 提供 token，audio 负责播放，config 提供 TOKEN_FILES；cli 不直接操作 sounddevice，也不解析 WAV&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=11;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="1530" height="62" as="geometry"/></mxCell><mxCell id="p7-v25" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;&lt;span style='color:#5B7FA6'&gt;━━&lt;/span&gt; 菜单分发&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;每个处理函数只做一件事；共享输入 / 展示 / 选择逻辑&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="1034" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p7-l26" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1068" as="sourcePoint"/><mxPoint x="1620" y="1068" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-v27" value="&lt;span style='font-size:11.5px;color:#6B7280'&gt;数字录音播报器 · number_voice 1.0 · 软件架构与 UML&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="1076" width="700" height="26" as="geometry"/></mxCell><mxCell id="p7-v28" value="&lt;div style='text-align:right;font-size:11.5px;color:#6B7280'&gt;07 / 13&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="1420" y="1076" width="200" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p8" name="08 支撑模块"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1080" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8-v1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#1F3864;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="38" as="geometry"/></mxCell><mxCell id="p8-v2" value="图 8　支撑模块：config / recordings / tests" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=25;fontColor=#1F3864;fontFamily=Songti SC;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="30" width="1080" height="40" as="geometry"/></mxCell><mxCell id="p8-v3" value="单一配置源 + 外部录音资源 + 测试与工具脚本 · 运行时只读，开发期可独立验证" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=12.8;fontColor=#5B6B7C;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="84" y="74" width="1150" height="26" as="geometry"/></mxCell><mxCell id="p8-v4" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;《软件开发方法》课程任务四 · Python 3.12&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=17;fillColor=#F3F6FA;strokeColor=#D5DEE8;strokeWidth=1.5;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="38" width="340" height="34" as="geometry"/></mxCell><mxCell id="p8-l5" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="112" as="sourcePoint"/><mxPoint x="1620" y="112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p8-v6" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px;color:#7A4F1D&quot;&gt;config.py · 单一配置源&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.4px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;项目根、录音目录、音频参数和 19 个字音文件名都集中在这里；其他模块只读取。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FDF3E5;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=11.4;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="520" height="550" as="geometry"/></mxCell><mxCell id="p8-v7" value="&lt;div style='font-family:Menlo;font-size:11.2px;line-height:1.85;color:#1F2937'&gt;PROJECT_DIR = Path(__file__).resolve()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;.parent.parent&lt;br&gt;RECOGNIZE_DIR = PROJECT_DIR / &quot;recordings&quot;&lt;br&gt;SAMPLE_RATE = 22050&lt;br&gt;CHANNELS = 1&lt;br&gt;SAMPLE_WIDTH = 2&amp;nbsp;&amp;nbsp;# 字节 / 采样&lt;br&gt;TOKEN_FILES = dict(zip(...))&amp;nbsp;&amp;nbsp;# 19 项&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=11.2;fontColor=#1F2937;fontFamily=Menlo;" vertex="1" parent="1"><mxGeometry x="90" y="225" width="460" height="210" as="geometry"/></mxCell><mxCell id="p8-v8" value="&lt;b style='font-size:11.5px;color:#7A4F1D'&gt;TOKEN_FILES（汉字 → 文件名）&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=11.5;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="90" y="440" width="460" height="26" as="geometry"/></mxCell><mxCell id="p8-v9" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;零&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;ling&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="475" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v10" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;一&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;yi&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="178" y="475" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v11" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;二&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;er&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="266" y="475" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v12" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;三&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;san&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="354" y="475" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v13" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;四&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;si&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="442" y="475" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v14" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;五&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;wu&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="513" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v15" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;六&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;liu&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="178" y="513" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v16" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;七&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;qi&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="266" y="513" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v17" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;八&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;ba&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="354" y="513" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v18" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;九&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;jiu&lt;/span&gt;&lt;/