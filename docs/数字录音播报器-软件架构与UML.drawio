<diagram id="p1" name="01 软件总体架构"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1080" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-v1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#1F3864;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="38" as="geometry"/></mxCell><mxCell id="p1-v2" value="图 1　软件总体架构（分层视图）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=25;fontColor=#1F3864;fontFamily=Songti SC;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="30" width="1080" height="40" as="geometry"/></mxCell><mxCell id="p1-v3" value="命令行三层架构 · 依赖方向 cli → numbers / audio → config · 不依赖 TTS、图形界面或录音界面" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=12.8;fontColor=#5B6B7C;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="84" y="74" width="1150" height="26" as="geometry"/></mxCell><mxCell id="p1-v4" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;《软件开发方法》课程任务四 · Python 3.12&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=17;fillColor=#F3F6FA;strokeColor=#D5DEE8;strokeWidth=1.5;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="38" width="340" height="34" as="geometry"/></mxCell><mxCell id="p1-l5" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="112" as="sourcePoint"/><mxPoint x="1620" y="112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-v6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#7A9CC6;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="135" width="110" height="225" as="geometry"/></mxCell><mxCell id="p1-v7" value="&lt;div style='text-align:center;color:#FFFFFF'&gt;&lt;b style='font-size:18px'&gt;表现层&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;CLI / Interaction&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="110" height="70" as="geometry"/></mxCell><mxCell id="p1-v8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.2;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="135" width="1420" height="225" as="geometry"/></mxCell><mxCell id="p1-actor9" value="用户" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#F3F6FA;strokeColor=#5B7FA6;strokeWidth=1.5;fontColor=#1F3864;fontSize=13;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="186" y="194" width="48" height="92" as="geometry"/></mxCell><mxCell id="p1-v10" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;cli.py · 命令行交互模块&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.6px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 循环菜单：① 查看读法　② 播放数字　③ 文件状态　④ 试听单字　⑤ 退出&lt;br&gt;• 职责：输入读取 / 读法选择 / 结果打印 / 错误提示&lt;br&gt;• 入口：&lt;span style='font-family:Menlo;font-size:11.5px'&gt;app.py&lt;/span&gt; · &lt;span style='font-family:Menlo;font-size:11.5px'&gt;python -m number_voice&lt;/span&gt;&lt;br&gt;• 无图形界面；播放期间阻塞，播完才回到菜单&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=12.6;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="258" y="158" width="470" height="195" as="geometry"/></mxCell><mxCell id="p1-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A9CC6;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p1-actor9" target="p1-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-v12" value="① 查看读法" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=13.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="155" width="370" height="45" as="geometry"/></mxCell><mxCell id="p1-v13" value="② 播放数字" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=13.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1165" y="155" width="370" height="45" as="geometry"/></mxCell><mxCell id="p1-v14" value="③ 查看录音文件状态" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=13.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="208" width="370" height="45" as="geometry"/></mxCell><mxCell id="p1-v15" value="④ 试听单字" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=13.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1165" y="208" width="370" height="45" as="geometry"/></mxCell><mxCell id="p1-v16" value="⑤ 退出（break）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=13.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="261" width="370" height="45" as="geometry"/></mxCell><mxCell id="p1-v17" value="菜单循环直到选择 ⑤" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFD;strokeColor=#C7D5E6;strokeWidth=1.5;fontColor=#5B6B7C;fontSize=12.2;fontFamily=Songti SC;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1165" y="261" width="370" height="45" as="geometry"/></mxCell><mxCell id="p1-v18" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;main() 读取选择后分发到对应处理函数；输入错误只提示，不退出程序&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="780" y="314" width="755" height="34" as="geometry"/></mxCell><mxCell id="p1-v19" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#8FBFA0;strokeColor=#8FBFA0;strokeWidth=1.5;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="382" width="110" height="210" as="geometry"/></mxCell><mxCell id="p1-v20" value="&lt;div style='text-align:center;color:#FFFFFF'&gt;&lt;b style='font-size:18px'&gt;业务逻辑层&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Domain&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="445" width="110" height="70" as="geometry"/></mxCell><mxCell id="p1-v21" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#E8F5EC;strokeColor=#8FBFA0;strokeWidth=1.2;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="382" width="1420" height="210" as="geometry"/></mxCell><mxCell id="p1-v22" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px;color:#1E5B3A&quot;&gt;numbers.py · 数字转换模块（纯函数）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.6px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 字符串 → 中文读法 token 列表，供播放层消费&lt;br&gt;• 数值读法：四位分组、零压缩、万 / 亿 / 兆 / 京&lt;br&gt;• 逐位读法：逐字符映射，保留前导零与末尾零&lt;br&gt;• 不依赖 config、文件系统或音频设备 → 可独立单测&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E8F5EC;strokeColor=#8FBFA0;strokeWidth=1.5;fontColor=#1E5B3A;fontSize=12.6;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="225" y="407" width="610" height="160" as="geometry"/></mxCell><mxCell id="p1-v23" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px;color:#1E5B3A&quot;&gt;audio.py · 音频播放模块&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.6px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• AudioStore：路径映射、缺失检查、WAV 格式校验、顺序播放&lt;br&gt;• 19 个单字 WAV；同一个字重复出现时复用同一文件&lt;br&gt;• sounddevice 惰性加载；RawOutputStream 22050 Hz / 单声道 / int16&lt;br&gt;• 失败快速返回：缺文件 / 格式不符 / 设备不可用 → 明确异常&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E8F5EC;strokeColor=#8FBFA0;strokeWidth=1.5;fontColor=#1E5B3A;fontSize=12.6;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="875" y="407" width="730" height="160" as="geometry"/></mxCell><mxCell id="p1-e24" value="编排读法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3F8F65;strokeWidth=1.7;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.45;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p1-v10" target="p1-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e25" value="编排播放" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3F8F65;strokeWidth=1.7;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p1-v10" target="p1-v23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="587" y="375"/><mxPoint x="1130" y="375"/></Array></mxGeometry></mxCell><mxCell id="p1-v26" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#C9A26B;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="614" width="110" height="230" as="geometry"/></mxCell><mxCell id="p1-v27" value="&lt;div style='text-align:center;color:#FFFFFF'&gt;&lt;b style='font-size:18px'&gt;基础设施层&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Infra&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="110" height="70" as="geometry"/></mxCell><mxCell id="p1-v28" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#FDF3E5;strokeColor=#C9A26B;strokeWidth=1.2;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="614" width="1420" height="230" as="geometry"/></mxCell><mxCell id="p1-v29" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px;color:#7A4F1D&quot;&gt;config.py · 单一配置源&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;span style='font-family:Menlo;font-size:11.5px'&gt;PROJECT_DIR / RECOGNIZE_DIR&lt;/span&gt;&lt;br&gt;22050 Hz · 1 声道 · 16 位（2 字节）&lt;br&gt;&lt;span style='font-family:Menlo;font-size:11.5px'&gt;TOKEN_FILES&lt;/span&gt;：19 个汉字 → 文件名&lt;br&gt;被 cli / audio 共同读取；numbers 不依赖它&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FDF3E5;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=12.2;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="225" y="640" width="390" height="175" as="geometry"/></mxCell><mxCell id="p1-v30" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px;color:#4B5563&quot;&gt;recordings/ · 外部录音&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;19 个单字 WAV（程序外录制）&lt;br&gt;22050 Hz · 单声道 · 16 位 PCM&lt;br&gt;手机 / Audacity / ffmpeg 准备&lt;br&gt;WAV 不提交 Git；程序只读&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#4B5563;fontSize=12.2;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="665" y="640" width="350" height="175" as="geometry"/></mxCell><mxCell id="p1-v31" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot