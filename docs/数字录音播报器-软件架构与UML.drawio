ive="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-v32" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;&lt;span style='color:#5B7FA6'&gt;━━&lt;/span&gt; 读取管线&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;两种读法共享 _parse 的输入校验；小数部分始终逐位读&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="1040" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p5-l33" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1068" as="sourcePoint"/><mxPoint x="1620" y="1068" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5-v34" value="&lt;span style='font-size:11.5px;color:#6B7280'&gt;数字录音播报器 · number_voice 1.0 · 软件架构与 UML&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="1076" width="700" height="26" as="geometry"/></mxCell><mxCell id="p5-v35" value="&lt;div style='text-align:right;font-size:11.5px;color:#6B7280'&gt;05 / 13&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="1420" y="1076" width="200" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p6" name="06 模块详解 audio"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1250" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6-v1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#1F3864;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="38" as="geometry"/></mxCell><mxCell id="p6-v2" value="图 6　模块详解 ②：audio.py 音频播放" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=25;fontColor=#1F3864;fontFamily=Songti SC;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="30" width="1080" height="40" as="geometry"/></mxCell><mxCell id="p6-v3" value="AudioStore.play(tokens)：先整体预检，再打开一个输出流，按 token 顺序逐段读取 WAV" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=12.8;fontColor=#5B6B7C;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="84" y="74" width="1150" height="26" as="geometry"/></mxCell><mxCell id="p6-v4" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;《软件开发方法》课程任务四 · Python 3.12&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=17;fillColor=#F3F6FA;strokeColor=#D5DEE8;strokeWidth=1.5;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="38" width="340" height="34" as="geometry"/></mxCell><mxCell id="p6-l5" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="112" as="sourcePoint"/><mxPoint x="1620" y="112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p6-v6" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15.5px;color:#1E5B3A&quot;&gt;AudioStore · 音频仓库&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.4px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;b&gt;状态&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Menlo;font-size:10.8px'&gt;directory: Path&lt;br&gt;_device_factory: Callable&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;方法&lt;/b&gt;&lt;br&gt;• path(token) → WAV 路径&lt;br&gt;• missing(tokens) → 去重缺失列表&lt;br&gt;• play(tokens) → 顺序播放&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10.8px;color:#5B6B7C'&gt;构造函数会创建 recordings/ 目录&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E8F5EC;strokeColor=#8FBFA0;strokeWidth=1.5;fontColor=#1E5B3A;fontSize=11.4;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="420" height="330" as="geometry"/></mxCell><mxCell id="p6-v7" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15px;color:#1F3864&quot;&gt;load_sounddevice() · 惰性导入&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 只有调用 play() 时才 import sounddevice&lt;br&gt;• ImportError / OSError → RuntimeError&lt;br&gt;• 通过 device_factory 注入，测试可替换&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=11.2;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="70" y="510" width="420" height="140" as="geometry"/></mxCell><mxCell id="p6-v8" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7A4F1D&quot;&gt;阻塞式播放&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.4px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;一次 play() 只打开一个输出流；播完最后一个字音才返回菜单。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FDF3E5;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=11.4;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="70" y="680" width="420" height="100" as="geometry"/></mxCell><mxCell id="p6-v9" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15px;color:#1E5B3A&quot;&gt;顺序与一致性&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 先整体检查缺失，再打开设备（fail-fast）&lt;br&gt;• 每个 WAV 播放前校验三要素&lt;br&gt;• 同一个 token 重复出现时重开同一文件&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E8F5EC;strokeColor=#8FBFA0;strokeWidth=1.5;fontColor=#1E5B3A;fontSize=11.2;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="70" y="810" width="420" height="140" as="geometry"/></mxCell><mxCell id="p6-v10" value="&lt;b&gt;play(tokens)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#1F3864;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=15;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="150" width="340" height="56" as="geometry"/></mxCell><mxCell id="p6-v11" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1E5B3A&quot;&gt;missing(tokens) · 缺失检查&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;dict.fromkeys 去重保序 → 逐个 &lt;span style='font-family:Menlo;font-size:10.8px'&gt;is_file()&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E8F5EC;strokeColor=#8FBFA0;strokeWidth=1.5;fontColor=#1E5B3A;fontSize=11;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="530" y="240" width="440" height="80" as="geometry"/></mxCell><mxCell id="p6-v12" value="有缺失?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=13;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="670" y="350" width="160" height="105" as="geometry"/></mxCell><mxCell id="p6-v13" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#7A2E2E&quot;&gt;缺失 → ValueError&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.5px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;请先准备录音文件：…&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FBE9E9;strokeColor=#C88A8A;strokeWidth=1.5;fontColor=#7A2E2E;fontSize=10.5;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1000" y="372" width="195" height="80" as="geometry"/></mxCell><mxCell id="p6-v14" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F3864&quot;&gt;device_factory() · 取得音频设备&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.8px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;调用 load_sounddevice()；失败说明依赖或系统设备不可用&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=10.8;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="530" y="510" width="440" height="80" as="geometry"/></mxCell><mxCell id="p6-v15" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:12.2px;color:#7A2E2E&quot;&gt;设备失败 → RuntimeError&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.5px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;无法加载 sounddevice&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FBE9E9;strokeColor=#C88A8A;strokeWidth=1.5;fontColor=#7A2E2E;fontSize=10.5;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1000" y="515" width="195" height="80" as="geometry"/></mxCell><mxCell id="p6-v16" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#7A4F1D&quot;&gt;with RawOutputStream(...)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;samplerate=22050 · channels=1 · dtype=int16&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FDF3E5;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=11;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="530" y="660" width="440" height="78" as="geometry"/></mxCell><mxCell id="p6-e17" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v10" target="p6-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-e18" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v11" target="p6-v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-e19" value="否（齐全）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3F8F65;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=10.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v12" target="p6-v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-e20" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C05B5B;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=10.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v12" target="p6-v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-e21" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3F8F65;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=10.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p6-v14" target="p6-v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-e22" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strok