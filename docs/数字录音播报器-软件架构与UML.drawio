r;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="354" y="551" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v23" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;亿&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;yi_large&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="442" y="551" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v24" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;兆&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;zhao&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="589" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v25" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;京&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;jing&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="178" y="589" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v26" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;负&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;fu&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="266" y="589" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v27" value="&lt;span style='font-size:11px'&gt;&lt;b&gt;点&lt;/b&gt; &lt;span style='font-family:Menlo;font-size:8.8px'&gt;dian&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=10;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="354" y="589" width="80" height="30" as="geometry"/></mxCell><mxCell id="p8-v28" value="&lt;span style='font-size:10.5px;color:#7A4F1D'&gt;亿使用 &lt;span style='font-family:Menlo'&gt;yi_large&lt;/span&gt;，避免和“一”的 &lt;span style='font-family:Menlo'&gt;yi.wav&lt;/span&gt; 重名&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="90" y="640" width="460" height="36" as="geometry"/></mxCell><mxCell id="p8-v29" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px;color:#4B5563&quot;&gt;recordings/ · 外部录音资源&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.4px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;19 个单字 WAV；程序只检查与播放，不提供录音界面，也不做语音合成。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F5F6F8;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#4B5563;fontSize=11.4;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="460" height="550" as="geometry"/></mxCell><mxCell id="p8-rs0" value="手机 / 系统录音工具录制 19 个字" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#4B5563;fontSize=10.8;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="270" width="400" height="48" as="geometry"/></mxCell><mxCell id="p8-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.2;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p8-rs0" target="p8-rs1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8-rs1" value="ffmpeg / Audacity 转码与裁剪静音" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#4B5563;fontSize=10.8;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="335" width="400" height="48" as="geometry"/></mxCell><mxCell id="p8-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.2;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p8-rs1" target="p8-rs2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8-rs2" value="统一存为 22050 Hz · 单声道 · 16 位 PCM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#4B5563;fontSize=10.8;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="400" height="48" as="geometry"/></mxCell><mxCell id="p8-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.2;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p8-rs2" target="p8-rs3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8-rs3" value="AudioStore 校验存在性与格式后播放" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#4B5563;fontSize=10.8;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="465" width="400" height="48" as="geometry"/></mxCell><mxCell id="p8-v33" value="&lt;span style='font-size:10.7px;color:#4B5563'&gt;• WAV 不提交 Git；个人录音不入公开仓库&lt;br&gt;• original_m4a/ 保留原始素材，程序不读取&lt;br&gt;• 目录由 config.RECOGNIZE_DIR 指向&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=10.7;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="650" y="535" width="400" height="90" as="geometry"/></mxCell><mxCell id="p8-v34" value="&lt;span style='font-size:10.2px;color:#9CA3AF'&gt;缺文件 / 格式不符会在播放前被拦截&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=10.2;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="650" y="635" width="400" height="30" as="geometry"/></mxCell><mxCell id="p8-v35" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px;color:#4C3B72&quot;&gt;tests 与工具脚本&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.4px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;不参与运行时；用于验证纯函数、检查资源、演示单次播放。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F3F0FA;strokeColor=#A99AC9;strokeWidth=1.5;fontColor=#4C3B72;fontSize=11.4;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="500" height="550" as="geometry"/></mxCell><mxCell id="p8-v36" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:13.2px;color:#4C3B72&quot;&gt;tests/test_numbers.py&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.4px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;NumberReaderTests · 4 个测试方法&lt;br&gt;27 组读法样例 + 12 例非法输入 × 2 转换器&lt;br&gt;覆盖：数字样例 / 前导零 / 超长回退 / 非法输入&lt;br&gt;&lt;span style='font-family:Menlo;font-size:10px'&gt;python -m unittest discover -s tests -v&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#A99AC9;strokeWidth=1.5;fontColor=#4C3B72;fontSize=10.4;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1150" y="240" width="440" height="150" as="geometry"/></mxCell><mxCell id="p8-v37" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:13.2px;color:#4C3B72&quot;&gt;check_files.py&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.4px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;实例化 AudioStore，检查 19 个 WAV 是否齐全；输出“缺少：…”或“19 个文件齐全”。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#A99AC9;strokeWidth=1.5;fontColor=#4C3B72;fontSize=10.4;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1150" y="410" width="440" height="85" as="geometry"/></mxCell><mxCell id="p8-v38" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:13.2px;color:#4C3B72&quot;&gt;say_number.py&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.4px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;单次转换 + 播放的演示脚本，不属于主菜单流程。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#A99AC9;strokeWidth=1.5;fontColor=#4C3B72;fontSize=10.4;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1150" y="515" width="440" height="75" as="geometry"/></mxCell><mxCell id="p8-v39" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:13.2px;color:#4C3B72&quot;&gt;ruff / compileall&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.4px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;可选静态检查与字节码编译检查，不是运行依赖。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#A99AC9;strokeWidth=1.5;fontColor=#4C3B72;fontSize=10.4;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1150" y="610" width="440" height="70" as="geometry"/></mxCell><mxCell id="p8-v40" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15.5px;color:#1F3864&quot;&gt;项目文件地图&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.3px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;div style='font-family:Menlo;font-size:11.3px;line-height:1.68;color:#1F2937'&gt;software/&lt;br&gt;├ app.py&amp;nbsp;&amp;nbsp;→ cli.main&lt;br&gt;├ check_files.py&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;say_number.py&lt;br&gt;├ pyproject.toml&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;requirements.txt&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;README.md&lt;br&gt;├ number_voice/&lt;br&gt;│&amp;nbsp;&amp;nbsp;├ config.py&amp;nbsp;&amp;nbsp;numbers.py&amp;nbsp;&amp;nbsp;audio.py&amp;nbsp;&amp;nbsp;cli.py&lt;br&gt;│&amp;nbsp;&amp;nbsp;└ __init__.py&amp;nbsp;&amp;nbsp;__main__.py&lt;br&gt;├ recordings/&amp;nbsp;&amp;nbsp;19 × WAV&amp;nbsp;&amp;nbsp;+&amp;nbsp;&amp;nbsp;README.md&lt;br&gt;└ tests/test_numbers.py&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F3F6FA;strokeColor=#7A8EA8;strokeWidth=1.5;fontColor=#1F3864;fontSize=11.3;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="800" height="270" as="geometry"/></mxCell><mxCell id="p8-v41" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15.5px;color:#1F3864&quot;&gt;关键不变量&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.3px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 不使用 TTS、语音合成包或现成数字转语音组件&lt;br&gt;• 无 GUI、无网络、无数据库；只有命令行&lt;br&gt;• 唯一运行依赖：sounddevice（&lt; 1.0）&lt;br&gt;• 19 个单字音；22050 Hz / 单声道 / 16 位 PCM&lt;br&gt;• 播放阻塞且顺序严格；同一字复用同一文件&lt;br&gt;• 录音由外部工具准备，程序只读不录&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=11.3;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="900" y="730" width="720" height="270" as="geometry"/></mxCell><mxCell id="p8-v42" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;支撑模块与运行时解耦：tests / check_files / say_number 不参与主菜单&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="1002" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p8-l43" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1028" as="sourcePoint"/><mxPoint x="1620" y="1028" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p8-v44" value="&lt;span style='font-size:11.5px;color:#6B7280'&gt;数字录音播报器 · number_voice 1.0 · 软件架构与 UML&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="1036" width="700" height="26" as="geometry"/></mxCell><mxCell id="p8-v45" value="&lt;div style='text-align:right;font-size:11.5px;color:#6B7280'&gt;08 / 13&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="1420" y="1036" width="200" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p9" name="09 UML 时序图"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1200" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p9-v1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#1F3864;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="38" as="geometry"/></mxCell><mxCell id="p9-v2" value="图 9　UML 时序图：播放数字（成功与异常）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=25;fontColor=#1F3864;fontFamily=Songti SC;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="30" width="1080" height="40" as="geometry"/></mxCell><mxCell id="p9-v3" value="一次「播放数字」调用的消息顺序 · 用户 → cli → numbers → AudioStore → wave / sounddevice" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=12.8;fontColor=#5B6B7C;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="84" y="74" width="1150" height="26" as="geometry"/></mxCell><mxCell id="p9-v4" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;《软件开发方法》课程任务四 · Python 3.12&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=17;fillColor=#F3F6FA;strokeColor=#D5DEE8;strokeWidth=1.5;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="38" width="340" height="34" as="geometry"/></mxCell><mxCell id="p9-l5" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="112" as="sourcePoint"/><mxPoint x="1620" y="112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9-v6" value=