7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p4-actor15" target="p4-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.25;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p4-actor15" target="p4-v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e21" value="«include»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A97C3F;strokeWidth=1.4;endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;fontColor=#5B6B7C;fontSize=11;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p4-v8" target="p4-v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e22" value="«include»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A97C3F;strokeWidth=1.4;endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;fontColor=#5B6B7C;fontSize=11;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p4-v9" target="p4-v13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="341"/><mxPoint x="740" y="314"/></Array></mxGeometry></mxCell><mxCell id="p4-e23" value="«include»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A97C3F;strokeWidth=1.4;endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;fontColor=#5B6B7C;fontSize=11;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p4-v9" target="p4-v14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="373"/><mxPoint x="765" y="534"/></Array></mxGeometry></mxCell><mxCell id="p4-e24" value="«include»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A97C3F;strokeWidth=1.4;endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;fontColor=#5B6B7C;fontSize=11;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p4-v11" target="p4-v14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="605"/><mxPoint x="780" y="570"/></Array></mxGeometry></mxCell><mxCell id="p4-actor25" value="扬声器 / 耳机" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#F3F6FA;strokeColor=#5B7FA6;strokeWidth=1.5;fontColor=#4B5563;fontSize=12.5;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="1260" y="495" width="48" height="92" as="geometry"/></mxCell><mxCell id="p4-e26" value="声音" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.3;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=10.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p4-actor25" target="p4-v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-v27" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15.5px;color:#4B5563&quot;&gt;前置条件&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.5px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• &lt;span style='font-family:Menlo;font-size:10.9px'&gt;recordings/&lt;/span&gt; 中 19 个单字 WAV 已准备好&lt;br&gt;• 由手机 / Audacity / ffmpeg 在程序外录制转换&lt;br&gt;• 程序不录音、不使用 TTS、不合成语音&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F5F6F8;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#4B5563;fontSize=11.5;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1230" y="165" width="380" height="150" as="geometry"/></mxCell><mxCell id="p4-v28" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15.5px;color:#1F3864&quot;&gt;系统能力概览&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.5px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;19 个单字音 · 2 种读法&lt;br&gt;1 个运行依赖（sounddevice）&lt;br&gt;无 GUI · 无网络 · 无数据库&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=11.5;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1230" y="340" width="380" height="120" as="geometry"/></mxCell><mxCell id="p4-v29" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:13.5px;color:#7A2E2E&quot;&gt;异常路径&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10.6px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;输入非法 / 录音缺失 / WAV 格式不符 / 设备不可用 → 打印中文提示并返回主菜单，程序不崩溃&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FBE9E9;strokeColor=#C88A8A;strokeWidth=1.5;fontColor=#7A2E2E;fontSize=10.6;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="390" y="850" width="800" height="64" as="geometry"/></mxCell><mxCell id="p4-v30" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7A4F1D&quot;&gt;系统约束&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 播放阻塞，播完才能接受下一条菜单命令&lt;br&gt;• 程序不录音，录音文件必须在外部准备&lt;br&gt;• 不判断录音内容是否清晰&lt;br&gt;• 不自动裁剪静音&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FDF3E5;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=11.2;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1230" y="620" width="380" height="140" as="geometry"/></mxCell><mxCell id="p4-v31" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;&lt;span style='color:#5B7FA6'&gt;━━&lt;/span&gt; 参与者关联&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#A97C3F'&gt;┅┅&lt;/span&gt; «include» 包含关系&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="1230" y="845" width="390" height="24" as="geometry"/></mxCell><mxCell id="p4-l32" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="948" as="sourcePoint"/><mxPoint x="1620" y="948" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-v33" value="&lt;span style='font-size:11.5px;color:#6B7280'&gt;数字录音播报器 · number_voice 1.0 · 软件架构与 UML&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="956" width="700" height="26" as="geometry"/></mxCell><mxCell id="p4-v34" value="&lt;div style='text-align:right;font-size:11.5px;color:#6B7280'&gt;04 / 13&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="1420" y="956" width="200" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p5" name="05 模块详解 numbers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1120" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5-v1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#1F3864;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="38" as="geometry"/></mxCell><mxCell id="p5-v2" value="图 5　模块详解 ①：numbers.py 数字转换" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=25;fontColor=#1F3864;fontFamily=Songti SC;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="30" width="1080" height="40" as="geometry"/></mxCell><mxCell id="p5-v3" value="输入文本 → 校验切分 → 两种读法 → 字音 token 列表 · 纯函数，不接触文件与音频设备" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=12.8;fontColor=#5B6B7C;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="84" y="74" width="1150" height="26" as="geometry"/></mxCell><mxCell id="p5-v4" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;《软件开发方法》课程任务四 · Python 3.12&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=17;fillColor=#F3F6FA;strokeColor=#D5DEE8;strokeWidth=1.5;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="38" width="340" height="34" as="geometry"/></mxCell><mxCell id="p5-l5" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="112" as="sourcePoint"/><mxPoint x="1620" y="112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5-v6" value="&lt;b&gt;输入数字文本&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;2382 / -23 / 12.50&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#F3F6FA;strokeColor=#7A8EA8;strokeWidth=1.5;fontColor=#1F3864;fontSize=11.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="140" width="200" height="64" as="geometry"/></mxCell><mxCell id="p5-v7" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;_parse(text) · 校验并切分&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.8px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 非空；可带 1 个前导负号 “-”&lt;br&gt;• 小数点至多 1 个，且点后必须有数字&lt;br&gt;• 只接受半角 0–9；拒绝空格 / 加号 / 全角 / 逗号&lt;br&gt;• 返回 (sign, integer, fraction | None)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F3F6FA;strokeColor=#7A8EA8;strokeWidth=1.5;fontColor=#1F3864;fontSize=11.8;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="600" y="240" width="480" height="170" as="geometry"/></mxCell><mxCell id="p5-v8" value="&lt;b&gt;READING_MODES&lt;/b&gt; · 字典注册表&lt;br&gt;&lt;span style='font-size:10.8px'&gt;数值读法 → number_tokens　逐位读法 → digit_tokens&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=12;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="450" width="360" height="72" as="geometry"/></mxCell><mxCell id="p5-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p5-v6" target="p5-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p5-v7" target="p5-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-v11" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15.5px;color:#1E5B3A&quot;&gt;设计约束：为什么能独立单测&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.9px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 纯函数：&lt;span style='font-family:Menlo;font-size:11px'&gt;str&lt;/span&gt; → &lt;span style='font-family:Menlo;font-size:11px'&gt;list[str]&lt;/span&gt;&lt;br&gt;• 无文件系统、音频设备、网络或全局状态&lt;br&gt;• 不依赖 config，也不依赖第三方库&lt;br&gt;• 非法输入统一抛 &lt;span style='font-family:Menlo;font-size:11px'&gt;ValueError&lt;/span&gt;&lt;br&gt;• tests 直接调用两个公开函数&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#7A4F1D'&gt;同一份输入规则同时约束两种读法&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E8F5EC;strokeColor=#8FBFA0;strokeWidth=1.5;fontColor=#1E5B3A;fontSize=11.9;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="470" height="320" as="geometry"/></mxCell><mxCell id="p5-v12" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15.5px;color:#7A4F1D&quot;&gt;代表样例与边界&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.7px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;2382&lt;/span&gt;　→　二千三百八十二&lt;br&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;10001&lt;/span&gt;　→　一万零一&lt;br&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;-23&lt;/span&gt;　→　负二十三&lt;br&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;12.50&lt;/span&gt;　→　十二点五零&lt;br&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;0023&lt;/span&gt;　→　零零二三（逐位）&lt;br&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;.5&lt;/span&gt;　→　零点五&lt;br&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;0&lt;/span&gt;　→　零　·　&lt;span style='font-family:Menlo;font-size:11px'&gt;-0&lt;/span&gt;　→　负零&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#7A4F1D'&gt;20 位上限：更长的整数部分自动回退逐位读&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FDF3E5;strokeColor=#C9A26B;strokeWidth=1.5;fontColor=#7A4F1D;fontSize=11.7;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1160" y="240" width="440" height="320" as="geometry"/></mxCell><mxCell id="p5-v13" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:16px;color:#1F3864&quot;&gt;逐位读法 · digit_tokens&lt;br&gt;&lt;span style='font-size:10.3px;font-weight:400;color:#5B6B7C'&gt;保留前导零与末尾零，不合并单位&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=11;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="90" y="585" width="560" height="310" as="geometry"/></mxCell><mxCell id="p5-ds0" value="① 遍历整数与小数部分的每个字符" style="rounded=1;whiteSpace=wrap;h