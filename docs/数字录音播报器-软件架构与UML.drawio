ry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e28" value="TOKEN_FILES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A99AC9;strokeWidth=1.4;endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;fontColor=#5B6B7C;fontSize=10.2;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p2-v14" target="p2-v11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="620"/><mxPoint x="574" y="620"/></Array></mxGeometry></mxCell><mxCell id="p2-e29" value="读取 19 个 WAV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A97C3F;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=6 4;fontColor=#5B6B7C;fontSize=10.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p2-v10" target="p2-v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e30" value="惰性导入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9CA3AF;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=6 4;fontColor=#5B6B7C;fontSize=10.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p2-v10" target="p2-v16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="978" y="720"/><mxPoint x="1175" y="720"/></Array></mxGeometry></mxCell><mxCell id="p2-v31" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15.5px;color:#1E5B3A&quot;&gt;设计要点：numbers.py 是纯函数核心&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.8px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 不 import config，不访问文件系统 / 音频设备 / 网络&lt;br&gt;• 输入字符串 → 输出 &lt;span style='font-family:Menlo;font-size:11px'&gt;list[str]&lt;/span&gt;，无全局状态&lt;br&gt;• 因此可以在没有扬声器和录音文件的环境里做完整单测&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E8F5EC;strokeColor=#8FBFA0;strokeWidth=1.5;fontColor=#1E5B3A;fontSize=11.8;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="55" y="755" width="620" height="130" as="geometry"/></mxCell><mxCell id="p2-v32" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:15px;color:#1F3864&quot;&gt;入口与运行方式&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;python app.py&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;python -m number_voice&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:Menlo;font-size:11px'&gt;number-voice&lt;/span&gt;（pyproject 脚本）&lt;br&gt;三种入口最终都调用 &lt;span style='font-family:Menlo;font-size:11px'&gt;cli.main()&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F3F6FA;strokeColor=#7A8EA8;strokeWidth=1.5;fontColor=#1F3864;fontSize=11.2;fontFamily=Songti SC;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1215" y="555" width="390" height="150" as="geometry"/></mxCell><mxCell id="p2-v33" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;&lt;span style='color:#5B7FA6'&gt;━━&lt;/span&gt; 调用 / 实例化&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;┅┅&lt;/span&gt; import / 依赖（虚线开口箭头）&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;▢&lt;/span&gt; 外部资源 / 外部库&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="55" y="925" width="1565" height="24" as="geometry"/></mxCell><mxCell id="p2-l34" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="998" as="sourcePoint"/><mxPoint x="1620" y="998" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-v35" value="&lt;span style='font-size:11.5px;color:#6B7280'&gt;数字录音播报器 · number_voice 1.0 · 软件架构与 UML&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="60" y="1006" width="700" height="26" as="geometry"/></mxCell><mxCell id="p2-v36" value="&lt;div style='text-align:right;font-size:11.5px;color:#6B7280'&gt;02 / 13&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=14;fontColor=#1F2937;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="1420" y="1006" width="200" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p3" name="03 UML 类图"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1150" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3-v1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#1F3864;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F2937;fontSize=14;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="38" as="geometry"/></mxCell><mxCell id="p3-v2" value="图 3　UML 类图：核心类与模块函数" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=25;fontColor=#1F3864;fontFamily=Songti SC;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="82" y="30" width="1080" height="40" as="geometry"/></mxCell><mxCell id="p3-v3" value="AudioStore 是唯一的业务类；numbers / cli / config 以「模块」方式组织，均为函数与常量" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontSize=12.8;fontColor=#5B6B7C;fontFamily=Songti SC;" vertex="1" parent="1"><mxGeometry x="84" y="74" width="1150" height="26" as="geometry"/></mxCell><mxCell id="p3-v4" value="&lt;span style='font-size:11.5px;color:#5B6B7C'&gt;《软件开发方法》课程任务四 · Python 3.12&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=17;fillColor=#F3F6FA;strokeColor=#D5DEE8;strokeWidth=1.5;fontColor=#5B6B7C;fontSize=11.5;fontFamily=Songti SC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="38" width="340" height="34" as="geometry"/></mxCell><mxCell id="p3-l5" value="" style="endArrow=none;html=1;strokeColor=#E5E7EB;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="112" as="sourcePoint"/><mxPoint x="1620" y="112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-cls6" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E8F5EC;strokeColor=#8FBFA0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="450" height="360" as="geometry"/></mxCell><mxCell id="p3-v7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5EC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="151" width="448" height="55" as="geometry"/></mxCell><mxCell id="p3-v8" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:16px;color:#1E5B3A&quot;&gt;numbers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6B7C&quot;&gt;«module» 数字转换&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Songti SC;fontColor=#1E5B3A;" vertex="1" parent="1"><mxGeometry x="61" y="154" width="438" height="50" as="geometry"/></mxCell><mxCell id="p3-l9" value="" style="endArrow=none;html=1;strokeColor=#8FBFA0;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="55" y="206" as="sourcePoint"/><mxPoint x="505" y="206" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-l10" value="" style="endArrow=none;html=1;strokeColor=#8FBFA0;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="55" y="312" as="sourcePoint"/><mxPoint x="505" y="312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-v11" value="&lt;div style=&quot;text-align:left;font-family:Menlo;font-size:11.6px;line-height:1.62;color:#1F2937&quot;&gt;&lt;span style='color:#3F8F65'&gt;+&lt;/span&gt; DIGITS: str = &quot;零…九&quot;&lt;br&gt;&lt;span style='color:#3F8F65'&gt;+&lt;/span&gt; SMALL_UNITS = (&quot;&quot;, 十, 百, 千)&lt;br&gt;&lt;span style='color:#3F8F65'&gt;+&lt;/span&gt; GROUP_UNITS = (&quot;&quot;, 万, 亿, 兆, 京)&lt;br&gt;&lt;span style='color:#3F8F65'&gt;+&lt;/span&gt; MAX_DIGITS = 20&lt;br&gt;&lt;span style='color:#3F8F65'&gt;+&lt;/span&gt; READING_MODES: dict[str, Callable]&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Menlo;fontColor=#1F2937;spacingLeft=10;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="59" y="208" width="442" height="100" as="geometry"/></mxCell><mxCell id="p3-v12" value="&lt;div style=&quot;text-align:left;font-family:Menlo;font-size:11.6px;line-height:1.62;color:#1F2937&quot;&gt;&lt;span style='color:#3F8F65'&gt;+&lt;/span&gt; number_tokens(text) → list[str]&lt;br&gt;&lt;span style='color:#3F8F65'&gt;+&lt;/span&gt; digit_tokens(text) → list[str]&lt;br&gt;&lt;span style='color:#7A8EA8'&gt;−&lt;/span&gt; _parse(text) → (sign, int, frac)&lt;br&gt;&lt;span style='color:#7A8EA8'&gt;−&lt;/span&gt; _integer_tokens(text) → list[str]&lt;br&gt;&lt;span style='color:#7A8EA8'&gt;−&lt;/span&gt; _group_tokens(value) → list[str]&lt;br&gt;&lt;span style='color:#7A8EA8'&gt;−&lt;/span&gt; _digit_tokens(text) → list[str]&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Menlo;fontColor=#1F2937;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="59" y="314" width="442" height="192" as="geometry"/></mxCell><mxCell id="p3-cls13" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1195" y="150" width="430" height="300" as="geometry"/></mxCell><mxCell id="p3-v14" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1196" y="151" width="428" height="55" as="geometry"/></mxCell><mxCell id="p3-v15" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:16px;color:#1F3864&quot;&gt;cli&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6B7C&quot;&gt;«module» 命令行交互&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor