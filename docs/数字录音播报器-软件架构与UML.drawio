ontFamily=Menlo;fontColor=#1F2937;spacingLeft=10;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="59" y="698" width="442" height="62" as="geometry"/></mxCell><mxCell id="p3-v40" value="&lt;div style=&quot;text-align:left;font-family:Menlo;font-size:11.6px;line-height:1.62;color:#1F2937&quot;&gt;&lt;span style='color:#7A8EA8'&gt;+&lt;/span&gt; readframes(n) → bytes&lt;br&gt;&lt;span style='color:#7A8EA8'&gt;+&lt;/span&gt; close() → None&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Menlo;fontColor=#1F2937;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="59" y="766" width="442" height="60" as="geometry"/></mxCell><mxCell id="p3-cls41" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9CA3AF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1195" y="640" width="430" height="190" as="geometry"/></mxCell><mxCell id="p3-v42" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1196" y="641" width="428" height="55" as="geometry"/></mxCell><mxCell id="p3-v43" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:16px;color:#4B5563&quot;&gt;RawOutputStream&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6B7C&quot;&gt;«external» sounddevice&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Songti SC;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1201" y="644" width="418" height="50" as="geometry"/></mxCell><mxCell id="p3-l44" value="" style="endArrow=none;html=1;strokeColor=#9CA3AF;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="696" as="sourcePoint"/><mxPoint x="1625" y="696" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-l45" value="" style="endArrow=none;html=1;strokeColor=#9CA3AF;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="764" as="sourcePoint"/><mxPoint x="1625" y="764" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-v46" value="&lt;div style=&quot;text-align:left;font-family:Menlo;font-size:11.6px;line-height:1.62;color:#1F2937&quot;&gt;&lt;span style='color:#7A8EA8'&gt;+&lt;/span&gt; samplerate: int = 22050&lt;br&gt;&lt;span style='color:#7A8EA8'&gt;+&lt;/span&gt; channels: int = 1&lt;br&gt;&lt;span style='color:#7A8EA8'&gt;+&lt;/span&gt; dtype: str = &quot;int16&quot;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Menlo;fontColor=#1F2937;spacingLeft=10;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1199" y="698" width="422" height="62" as="geometry"/></mxCell><mxCell id="p3-v47" value="&lt;div style=&quot;text-align:left;font-family:Menlo;font-size:11.6px;line-height:1.62;color:#1F2937&quot;&gt;&lt;span style='color:#7A8EA8'&gt;+&lt;/span&gt; write(data: bytes) → None&lt;br&gt;&lt;span style='color:#7A8EA8'&gt;+&lt;/span&gt; __enter__ / __exit__&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Menlo;fontColor=#1F2937;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1199" y="766" width="422" height="60" as="geometry"/></mxCell><mxCell id="p3-v48" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1E5B3A&quot;&gt;为什么 numbers 可以独立测试&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• 无 IO、无全局状态、无第三方依赖&lt;br&gt;• 输入与输出都是普通 Python 值&lt;br&gt;• &lt;span style='font-family:Menlo;font-size:10.8px'&gt;tests/test_numbers.py&lt;/span&gt; 直接调用两个公开函数&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E8F5EC;strokeColor=#8FBFA0;strokeWidth=1.5;fontColor=#1E5B3A;fontSize=11.2;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="55" y="860" width="450" height="140" as="geometry"/></mxCell><mxCell id="p3-v49" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#7A2E2E&quot;&gt;异常契约&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;&lt;span style='font-family:Menlo;font-size:10.8px'&gt;ValueError&lt;/span&gt;：输入非法 / 录音缺失 / WAV 格式不符&lt;br&gt;&lt;span style='font-family:Menlo;font-size:10.8px'&gt;RuntimeError&lt;/span&gt;：sounddevice 无法加载&lt;br&gt;在 cli 边界统一转为中文提示&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FBE9E9;strokeColor=#C88A8A;strokeWidth=1.5;fontColor=#7A2E2E;fontSize=11.2;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="620" y="880" width="470" height="120" as="geometry"/></mxCell><mxCell id="p3-v50" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F3864&quot;&gt;可测试性设计&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11.2px;line-height:1.62;color:#374151;margin-top:7px&quot;&gt;• &lt;span style='font-family:Menlo;font-size:10.8px'&gt;device_factory&lt;/span&gt; 由构造函数注入&lt;br&gt;• 测试可替换为假设备，不必打开扬声器&lt;br&gt;• cli 不直接 import sounddevice&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#7A9CC6;strokeWidth=1.5;fontColor=#1F3864;fontSize=11.2;fontFamily=Songti SC;align=left;verticalAlign=top;dashed=1;dashPattern=6 4;spacingLeft=14;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1195" y="860" width="430" height="140" as="geometry"/></mxCell><mxCell id="p3-e51" value="«creates» AudioStore()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B7FA6;strokeWidth=1.7;endArrow=block;endFill=1;endSize=7;fontColor=#5B6B7C;fontSize=10.5;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p3-cls13" target="p3-cls20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e52" value="«uses» READING_MODES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3F8F65;strokeWidth=1.5;endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;fontColor=#5B6B7C;fontSize=11;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.25;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p3-cls13" target="p3-cls6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="132"/><mxPoint x="460" y="132"/></Array></mxGeometry></mxCell><mxCell id="p3-e53" value="«import» TOKEN_FILES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A97C3F;strokeWidth=1.5;endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;fontColor=#5B6B7C;fontSize=10.2;fontFamily=Songti SC;labelBackgroundColor=#FFFFFF;exitX=0.05;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p3-cls13" target="p3-cls27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1216" y="620"/><mxPoint x="1090" y="620"/></Array></mxGeometry></mxCell><mxCell id="p3-e54" value="RECOGNIZE_DIR / 音频参数" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A97C3F;strokeWidth=1.5;endArrow=open;endFil